# TrendView83 Backend Environment Variables
# Copy to .env and adjust if needed

# Reddit (read-only, no auth required)
REDDIT_USER_AGENT=TrendView83/0.1 by u/anonymous

# Subreddits to monitor (comma-separated)
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,SecurityAnalysis,ValueInvesting

# Fetch interval in minutes
FETCH_INTERVAL_MINUTES=5

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173